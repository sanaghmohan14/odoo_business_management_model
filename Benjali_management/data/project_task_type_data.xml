<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 1. New -->
    <record id="task_stage_new" model="project.task.type">
        <field name="name">New</field>
        <field name="sequence">1</field>
        <field name="fold">False</field>
    </record>

    <!-- 2. Ongoing -->
    <record id="task_stage_ongoing" model="project.task.type">
        <field name="name">Ongoing</field>
        <field name="sequence">2</field>
        <field name="fold">False</field>
    </record>

    <!-- 3. Done -->
    <record id="task_stage_done" model="project.task.type">
        <field name="name">Done</field>
        <field name="sequence">3</field>
        <field name="fold">False</field>
    </record>

    <!-- 4. Cancelled -->
    <record id="task_stage_cancelled" model="project.task.type">
        <field name="name">Cancelled</field>
        <field name="sequence">4</field>
        <field name="fold">True</field>
    </record>

    <!-- 5. On Hold -->
    <record id="task_stage_on_hold" model="project.task.type">
        <field name="name">On Hold</field>
        <field name="sequence">5</field>
        <field name="fold">True</field>
    </record>

</odoo>