<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Scheduled Action to generate daily repeating KPIs under active KRAs -->
        <record id="ir_cron_generate_daily_repeating_kpis" model="ir.cron">
            <field name="name">KRA: Auto-Generate Daily Repeating KPIs</field>
            <field name="model_id" ref="model_business_project_kra"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_daily_repeating_kpis()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
