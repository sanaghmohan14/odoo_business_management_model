<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="BenjaliManagement.Dashboard">

        <div class="benjali_dashboard">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div class="dashboard_top">

                <div class="dashboard_title">

                    <div class="dashboard_icon">
                        <i class="fa fa-bar-chart"/>
                    </div>

                    <div>

                        <h1>
                            Dashboard
                        </h1>

                        <p>
                            Business Management Overview
                        </p>

                    </div>

                </div>


                <div class="dashboard_filters">

                    <div class="filter_box">

    <i class="fa fa-building-o"/>

    <select
        t-if="state.data"
        t-on-change="onDepartmentChange"
        t-att-value="state.departmentId || ''"
    >

        <option value="">
            All Departments
        </option>

        <t
            t-foreach="state.data.departments"
            t-as="department"
            t-key="department.id"
        >
            <option t-att-value="department.id">
                <t t-esc="department.name"/>
            </option>
        </t>

    </select>

    <select
        t-else=""
        disabled="disabled"
    >
        <option>
            Loading departments...
        </option>
    </select>

</div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- LOADING -->
            <!-- ================================================= -->

            <t t-if="state.loading">

                <div class="dashboard_loading">

                    <div class="loading_spinner"/>

                    <p>
                        Loading dashboard...
                    </p>

                </div>

            </t>


            <!-- ================================================= -->
            <!-- ERROR -->
            <!-- ================================================= -->

            <t t-elif="state.error">

                <div class="dashboard_error">

                    <i class="fa fa-exclamation-triangle"/>

                    <h3>
                        Unable to load dashboard
                    </h3>

                    <p>
                        Please refresh the page.
                    </p>

                </div>

            </t>


            <!-- ================================================= -->
            <!-- DASHBOARD -->
            <!-- ================================================= -->

            <t t-elif="state.data">

                <!-- ============================================= -->
                <!-- PROJECT KPI -->
                <!-- ============================================= -->

                <div class="kpi_grid">

                    <!-- TOTAL -->

                    <div
                        class="modern_kpi blue"
                        t-on-click="openProjects"
                    >

                        <div class="kpi_icon">
                            <i class="fa fa-folder-open"/>
                        </div>

                        <div class="kpi_information">

                            <span>
                                Total Projects
                            </span>

                            <strong>
                                <t t-esc="state.data.projects.total"/>
                            </strong>

                            <small>
                                All business projects
                            </small>

                        </div>

                        <div class="kpi_graph">
                            ↗
                        </div>

                    </div>


                    <!-- ACTIVE -->

                    <div class="modern_kpi green">

                        <div class="kpi_icon">
                            <i class="fa fa-play"/>
                        </div>

                        <div class="kpi_information">

                            <span>
                                Active Projects
                            </span>

                            <strong>
                                <t t-esc="state.data.projects.active"/>
                            </strong>

                            <small>
                                Currently active
                            </small>

                        </div>

                        <div class="kpi_graph">
                            ↗
                        </div>

                    </div>


                    <!-- COMPLETED -->

                    <div class="modern_kpi purple">

                        <div class="kpi_icon">
                            <i class="fa fa-check"/>
                        </div>

                        <div class="kpi_information">

                            <span>
                                Completed
                            </span>

                            <strong>
                                <t t-esc="state.data.projects.completed"/>
                            </strong>

                            <small>
                                Successfully completed
                            </small>

                        </div>

                        <div class="kpi_graph">
                            ✓
                        </div>

                    </div>


                    <!-- HOLD -->

                    <div class="modern_kpi orange">

                        <div class="kpi_icon">
                            <i class="fa fa-pause"/>
                        </div>

                        <div class="kpi_information">

                            <span>
                                On Hold
                            </span>

                            <strong>
                                <t t-esc="state.data.projects.on_hold"/>
                            </strong>

                            <small>
                                Projects currently on hold
                            </small>

                        </div>

                        <div class="kpi_graph">
                            ||
                        </div>

                    </div>


                    <!-- CANCELLED -->

                    <div class="modern_kpi red">

                        <div class="kpi_icon">
                            <i class="fa fa-times"/>
                        </div>

                        <div class="kpi_information">

                            <span>
                                Cancelled
                            </span>

                            <strong>
                                <t t-esc="state.data.projects.cancelled"/>
                            </strong>

                            <small>
                                Cancelled projects
                            </small>

                        </div>

                        <div class="kpi_graph">
                            ×
                        </div>

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- CHART ROW -->
                <!-- ============================================= -->

                <div class="dashboard_grid chart_row">


                    <!-- PROJECT STATUS -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-pie-chart purple_icon"/>

                                <span>
                                    Project Status Distribution
                                </span>

                            </div>

                            <i class="fa fa-ellipsis-v"/>

                        </div>


                        <div class="donut_layout">

                            <div class="donut_wrapper">

                                <div
                                    class="donut_chart"
                                    t-att-style="getStatusChartStyle()"
                                >

                                    <div class="donut_center">

                                        <strong>
                                            <t t-esc="state.data.projects.total"/>
                                        </strong>

                                        <span>
                                            Total Projects
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="chart_legend">

                                <t
                                    t-foreach="state.data.status"
                                    t-as="item"
                                    t-key="item.name"
                                >

                                    <div class="legend_item">

                                        <span
                                            class="legend_dot"
                                            t-att-class="item.class"
                                        />

                                        <span>
                                            <t t-esc="item.name"/>
                                        </span>

                                        <strong>
                                            <t t-esc="item.count"/>
                                        </strong>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>


                    <!-- DEPARTMENT BAR CHART -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-users blue_icon"/>

                                <span>
                                    Projects by Department
                                </span>

                            </div>

                            <i class="fa fa-ellipsis-v"/>

                        </div>


                        <div class="bar_chart">

                            <t
                                t-foreach="state.data.departments"
                                t-as="department"
                                t-key="department.id"
                            >

                                <div class="bar_item">

                                    <div class="bar_value">
                                        <t t-esc="department.count"/>
                                    </div>

                                    <div class="bar_column_area">

                                        <div
                                            class="bar_column"
                                            t-att-style="'height:' + getBarHeight(department.count) + '%;'"
                                        />

                                    </div>

                                    <div class="bar_label">

                                        <t t-esc="department.name"/>

                                    </div>

                                </div>

                            </t>

                        </div>

                    </div>


                    <!-- PIPELINE -->

                    <div class="dashboard_card pipeline_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-sitemap blue_icon"/>

                                <span>
                                    Project Pipeline
                                </span>

                            </div>

                            <strong class="stage_badge">
                                16 Stages
                            </strong>

                        </div>


                        <div class="pipeline_list">

                            <t
                                t-foreach="state.data.stages"
                                t-as="stage"
                                t-key="stage.id"
                            >

                                <div
                                    class="pipeline_item"
                                    t-on-click="() => this.openStage(stage.id)"
                                >

                                    <div class="pipeline_name">

                                        <span>
                                            <t t-esc="stage.name"/>
                                        </span>

                                    </div>

                                    <div class="pipeline_bar">

                                        <div
                                            class="pipeline_progress"
                                            t-att-style="'width:' + getPipelineWidth(stage.count) + '%;'"
                                        />

                                    </div>

                                    <strong>
                                        <t t-esc="stage.count"/>
                                    </strong>

                                </div>

                            </t>

                        </div>

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- SECOND ROW -->
                <!-- ============================================= -->

                <div class="dashboard_grid three_columns">


                    <!-- KRA -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-bullseye purple_icon"/>

                                <span>
                                    KRA Overview
                                </span>

                            </div>

                            <i class="fa fa-ellipsis-v"/>

                        </div>


                        <div class="mini_kpi_grid">

                            <div
                                class="mini_kpi blue_light"
                                t-on-click="openKras"
                            >

                                <i class="fa fa-file-text"/>

                                <span>
                                    Total KRAs
                                </span>

                                <strong>
                                    <t t-esc="state.data.kra.total"/>
                                </strong>

                            </div>


                            <div class="mini_kpi green_light">

                                <i class="fa fa-check-circle"/>

                                <span>
                                    Active KRAs
                                </span>

                                <strong>
                                    <t t-esc="state.data.kra.active"/>
                                </strong>

                            </div>


                            <div class="mini_kpi purple_light">

                                <i class="fa fa-link"/>

                                <span>
                                    Projects With KRAs
                                </span>

                                <strong>
                                    <t t-esc="state.data.kra.projects_with_kra"/>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- ACTIVITY -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-tasks purple_icon"/>

                                <span>
                                    Activity Overview
                                </span>

                            </div>

                            <i class="fa fa-ellipsis-v"/>

                        </div>


                        <div class="donut_layout small">

                            <div class="donut_wrapper">

                                <div
                                    class="donut_chart"
                                    t-att-style="getActivityChartStyle()"
                                >

                                    <div class="donut_center">

                                        <strong>
                                            <t t-esc="state.data.activities.total"/>
                                        </strong>

                                        <span>
                                            Activities
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="chart_legend">

                                <t
                                    t-foreach="state.data.activities.chart"
                                    t-as="item"
                                    t-key="item.name"
                                >

                                    <div class="legend_item">

                                        <span class="legend_dot blue_dot"/>

                                        <span>
                                            <t t-esc="item.name"/>
                                        </span>

                                        <strong>
                                            <t t-esc="item.count"/>
                                        </strong>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>


                    <!-- DATA COLLECTION -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-database purple_icon"/>

                                <span>
                                    Data Collection
                                </span>

                            </div>

                            <i class="fa fa-ellipsis-v"/>

                        </div>


                        <div class="donut_layout small">

                            <div class="donut_wrapper">

                                <div
                                    class="donut_chart"
                                    t-att-style="getDataCollectionChartStyle()"
                                >

                                    <div class="donut_center">

                                        <strong>
                                            <t t-esc="state.data.data_collection.total"/>
                                        </strong>

                                        <span>
                                            Total
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="chart_legend">

                                <t
                                    t-foreach="state.data.data_collection.chart"
                                    t-as="item"
                                    t-key="item.name"
                                >

                                    <div class="legend_item">

                                        <span class="legend_dot green_dot"/>

                                        <span>
                                            <t t-esc="item.name"/>
                                        </span>

                                        <strong>
                                            <t t-esc="item.count"/>
                                        </strong>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- THIRD ROW -->
                <!-- ============================================= -->

                <div class="dashboard_grid three_columns">


                    <!-- TEAM -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-users blue_icon"/>

                                <span>
                                    Team &amp; Timesheets
                                </span>

                            </div>

                        </div>


                        <div class="mini_kpi_grid">

                            <div class="mini_kpi blue_light">

                                <i class="fa fa-user"/>

                                <span>
                                    Active Team Members
                                </span>

                                <strong>
                                    <t t-esc="state.data.team.total_active_members"/>
                                </strong>

                            </div>


                            <div class="mini_kpi purple_light">

                                <i class="fa fa-file-text"/>

                                <span>
                                    Timesheets
                                </span>

                                <strong>
                                    <t t-esc="state.data.timesheets.total"/>
                                </strong>

                            </div>


                            <div class="mini_kpi green_light">

                                <i class="fa fa-clock-o"/>

                                <span>
                                    Timesheet Hours
                                </span>

                                <strong>
                                    <t t-esc="state.data.timesheets.total_hours.toFixed(1)"/>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- CRM -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-handshake-o purple_icon"/>

                                <span>
                                    CRM Overview
                                </span>

                            </div>

                        </div>


                        <div class="mini_kpi_grid">

                            <div class="mini_kpi blue_light">

                                <i class="fa fa-users"/>

                                <span>
                                    Total CRM Leads
                                </span>

                                <strong>
                                    <t t-esc="state.data.crm.total"/>
                                </strong>

                            </div>


                            <div class="mini_kpi green_light">

                                <i class="fa fa-check-circle"/>

                                <span>
                                    Converted to Projects
                                </span>

                                <strong>
                                    <t t-esc="state.data.crm.with_business_project"/>
                                </strong>

                            </div>


                            <div class="mini_kpi orange_light">

                                <i class="fa fa-clock-o"/>

                                <span>
                                    Without Project
                                </span>

                                <strong>
                                    <t t-esc="state.data.crm.without_business_project"/>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- PHASE -->

                    <div class="dashboard_card">

                        <div class="card_header">

                            <div>

                                <i class="fa fa-pie-chart purple_icon"/>

                                <span>
                                    Phase Distribution
                                </span>

                            </div>

                        </div>


                        <div class="phase_list">

                            <t
                                t-foreach="state.data.phases"
                                t-as="phase"
                                t-key="phase.code"
                            >

                                <div class="phase_item">

                                    <div class="phase_name">

                                        <span>
                                            <t t-esc="phase.name"/>
                                        </span>

                                        <strong>
                                            <t t-esc="phase.count"/>
                                        </strong>

                                    </div>

                                    <div class="phase_track">

                                        <div
                                            class="phase_fill"
                                            t-att-style="'width:' + getPipelineWidth(phase.count) + '%;'"
                                        />

                                    </div>

                                </div>

                            </t>

                        </div>

                    </div>

                </div>

            </t>

        </div>

    </t>

</templates>