<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         ACTIONS
    ========================================== -->

    <!-- 1. Key Result Areas (KRAs) -->
    <record id="business_project_kra_action" model="ir.actions.act_window">
        <field name="name">Key Result Areas (KRAs)</field>
        <field name="res_model">business.project.kra</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="context">{'search_default_group_stage_id': 1, 'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Key Result Areas (KRAs).
            </p>
            <p>
                Each KRA represents a major area under a Project with 4 stages: New, Ongoing, Completed, and On Hold.
            </p>
        </field>
    </record>

    <!-- 2. Key Performance Indicators (KPIs) -->
    <record id="business_project_kpi_action" model="ir.actions.act_window">
        <field name="name">Key Performance Indicators (KPIs)</field>
        <field name="res_model">business.project.kpi</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="context">{'search_default_group_stage_id': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Key Performance Indicators (KPIs).
            </p>
            <p>
                Each KPI is a measurable task with stages: Not Started, In Progress, Completed, On Hold, and Cancelled.
                Includes an interactive progress bar slider and timesheets tracking.
            </p>
        </field>
    </record>

    <!-- 3. Daily Report Action -->
    <record id="business_project_daily_report_action" model="ir.actions.act_window">
        <field name="name">Daily KRA &amp; KPI Report</field>
        <field name="res_model">business.project.kpi</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="context">{'search_default_filter_today': 1, 'search_default_group_kra': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Daily Report for KRAs and KPIs.
            </p>
        </field>
    </record>

    <!-- 4. Weekly Report Action -->
    <record id="business_project_weekly_report_action" model="ir.actions.act_window">
        <field name="name">Weekly KRA &amp; KPI Report</field>
        <field name="res_model">business.project.kpi</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_filter_this_week': 1, 'search_default_group_week': 1, 'search_default_group_kra': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Weekly Report for KRAs and KPIs.
            </p>
        </field>
    </record>

    <!-- 5. Monthly Report Action -->
    <record id="business_project_monthly_report_action" model="ir.actions.act_window">
        <field name="name">Monthly KRA &amp; KPI Report</field>
        <field name="res_model">business.project.kpi</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_filter_this_month': 1, 'search_default_group_month': 1, 'search_default_group_kra': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Monthly Report for KRAs and KPIs.
            </p>
        </field>
    </record>

    <!-- 6. Performance Entries Action -->
    <record id="business_project_kra_entry_action" model="ir.actions.act_window">
        <field name="name">Performance Entries</field>
        <field name="res_model">business.project.kra.entry</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="context">{'search_default_group_department': 1}</field>
    </record>


    <!-- ==========================================
         KPI VIEWS (SUB-TASKS)
    ========================================== -->

    <record id="business_project_kpi_list" model="ir.ui.view">
        <field name="name">business.project.kpi.list</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <list string="Key Performance Indicators (KPIs)">
                <field name="sequence" widget="handle"/>
                <field name="date"/>
                <field name="name" string="KPI Name"/>
                <field name="kra_id" string="KRA"/>
                <field name="project_id" string="Project" optional="show"/>
                <field name="manager_id" string="KRA Manager" optional="show"/>
                <field name="employee_ids" widget="many2many_tags_avatar" string="Assigned Employees"/>
                <field name="is_daily_repeating" string="Repeating?" widget="boolean_toggle"/>
                <field name="progress" widget="progressbar" string="Progress"/>
                <field name="total_hours_spent" widget="float_time" string="Hours" optional="show"/>
                <field name="stage_id" string="Stage" optional="show"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'not_started'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'on_hold'"
                       decoration-danger="state == 'cancelled'"/>
                <button name="action_set_completed"
                        type="object"
                        title="Mark Completed"
                        icon="fa-check text-success"
                        invisible="state == 'completed'"/>
                <button name="action_set_in_progress"
                        type="object"
                        title="Mark In Progress"
                        icon="fa-play text-warning"
                        invisible="state == 'in_progress'"/>
                <button name="action_set_on_hold"
                        type="object"
                        title="Put On Hold"
                        icon="fa-pause text-secondary"
                        invisible="state == 'on_hold'"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- KPI Kanban View -->
    <record id="business_project_kpi_kanban" model="ir.ui.view">
        <field name="name">business.project.kpi.kanban</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" records_draggable="1">
                <field name="stage_id" options="{'group_by_tooltip': {'description': 'Stage Details'}}"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kra_id"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <field name="employee_ids"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="date"/>
                <field name="is_daily_repeating"/>
                <field name="progress"/>
                <field name="total_hours_spent"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <!-- Top: State and Repeating badge -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <field name="state" widget="badge"
                                       decoration-muted="state == 'not_started'"
                                       decoration-warning="state == 'in_progress'"
                                       decoration-success="state == 'completed'"
                                       decoration-info="state == 'on_hold'"
                                       decoration-danger="state == 'cancelled'"/>
                                <t t-if="record.is_daily_repeating.raw_value">
                                    <span class="badge bg-secondary text-white"><i class="fa fa-refresh me-1" title="Repeating Task"/> Repeating</span>
                                </t>
                            </div>

                            <!-- KPI Name -->
                            <div class="fw-bold fs-6 text-dark mb-1">
                                <field name="name"/>
                            </div>

                            <!-- KRA Name & Project Name -->
                            <div class="text-muted small mb-2">
                                <div class="mb-1">
                                    <i class="fa fa-tasks me-1 text-primary" title="KRA"/>
                                    <strong><field name="kra_id"/></strong>
                                </div>
                                <t t-if="record.project_id.raw_value">
                                    <div>
                                        <i class="fa fa-folder-open-o me-1 text-secondary" title="Project"/>
                                        <span><field name="project_id"/></span>
                                    </div>
                                </t>
                            </div>

                            <!-- Progress Bar -->
                            <div class="my-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Progress</span>
                                    <span class="fw-bold"><field name="progress"/>%</span>
                                </div>
                                <field name="progress" widget="progressbar"/>
                            </div>

                            <!-- Footer: Assigned Employees & Hours -->
                            <div class="d-flex justify-content-between align-items-center text-muted small mt-2 pt-2 border-top">
                                <div class="d-flex align-items-center">
                                    <field name="employee_ids" widget="many2many_tags_avatar"/>
                                </div>
                                <t t-if="record.total_hours_spent.raw_value">
                                    <span class="badge bg-light text-primary border">
                                        <i class="fa fa-clock-o me-1" title="Recorded Hours"/> <field name="total_hours_spent" widget="float_time"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- KPI Form View -->
    <record id="business_project_kpi_form" model="ir.ui.view">
        <field name="name">business.project.kpi.form</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <form string="Key Performance Indicator (KPI)">
                <header>
                    <button name="action_set_in_progress" string="Start Work" type="object"
                            class="btn-primary" invisible="state == 'in_progress'"/>
                    <button name="action_set_completed" string="Mark Completed" type="object"
                            class="btn-success" invisible="state == 'completed'"/>
                    <button name="action_set_on_hold" string="Put On Hold" type="object"
                            class="btn-secondary" invisible="state == 'on_hold'"/>
                    <button name="action_set_cancelled" string="Cancel" type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_set_not_started" string="Reset to Not Started" type="object"
                            invisible="state == 'not_started'"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': True}"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Timesheets Smart Button -->
                        <button name="action_view_timesheets" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="total_hours_spent" widget="float_time"/></span>
                                <span class="o_stat_text">Timesheets</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="code" readonly="1"/></span>
                        <h1><field name="name" placeholder="KPI Name"/></h1>
                    </div>
                    <group>
                        <group string="Scope &amp; Assignment">
                            <!-- KRA Selection -->
                            <field name="kra_id" string="KRA" placeholder="Choose KRA"/>
                            <!-- Auto-filled Project and Manager -->
                            <field name="project_id" string="Project" readonly="1" force_save="1" placeholder="Auto filled from KRA"/>
                            <field name="manager_id" string="KRA Manager" readonly="1" force_save="1" placeholder="Auto filled from KRA"/>
                            <field name="employee_ids" string="Assigned Employees" widget="many2many_tags_avatar" placeholder="Select employees"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group string="Schedule &amp; Progress">
                            <field name="date"/>
                            <field name="is_daily_repeating" string="Repeating Task" widget="boolean_toggle"/>
                            <field name="recurring_template_id" invisible="not is_daily_repeating or not recurring_template_id" readonly="1"/>
                            
                            <!-- Progress Bar with Sliding Option up to 100 -->
                            <label for="progress"/>
                            <div>
                                <div class="d-flex align-items-center gap-3">
                                    <field name="progress" widget="range" options="{'min': 0, 'max': 100, 'step': 1}" class="flex-grow-1"/>
                                    <span class="badge bg-primary fs-6 px-3 py-1"><field name="progress" nolabel="1"/>%</span>
                                </div>
                                <div class="mt-2">
                                    <field name="progress" widget="progressbar"/>
                                </div>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <!-- Timesheets Notebook Page -->
                        <page string="Timesheets" name="timesheets">
                            <field name="timesheet_ids" context="{'default_kpi_id': id, 'default_business_project_id': project_id, 'default_name': name}">
                                <list editable="bottom" string="Timesheet Lines">
                                    <field name="date"/>
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="name" string="Description"/>
                                    <field name="unit_amount" string="Hours Spent" sum="Total Hours" widget="timesheet_uom"/>
                                    <field name="account_id" column_invisible="True"/>
                                    <field name="project_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- Targets & Performance Notebook Page -->
                        <page string="Performance &amp; Targets" name="targets">
                            <group>
                                <group string="Weekly Target &amp; Weight">
                                    <label for="weekly_target"/>
                                    <div class="o_row">
                                        <field name="weekly_target"/>
                                        <field name="unit" placeholder="units"/>
                                    </div>
                                    <field name="weekly_weightage" string="Weekly Weightage (%)"/>
                                    <field name="weekly_achievement" string="Weekly Achieved"/>
                                    <field name="weekly_progress" widget="progressbar" string="Weekly Progress (%)"/>
                                </group>
                                <group string="Monthly Calculation">
                                    <field name="monthly_target" readonly="1"/>
                                    <field name="monthly_achievement" widget="progressbar" string="Monthly Score (/100)"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes &amp; Description" name="notes">
                            <field name="description" placeholder="Instructions, criteria, or details for this KPI..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KPI Search View -->
    <record id="business_project_kpi_search" model="ir.ui.view">
        <field name="name">business.project.kpi.search</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <search string="KPIs">
                <field name="name"/>
                <field name="code"/>
                <field name="kra_id"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <field name="employee_ids"/>
                <field name="hr_employee_ids" string="HR Employee"/>
                <field name="stage_id"/>
                <field name="date"/>
                <filter name="filter_today" string="Today" domain="[('is_today', '=', True)]"/>
                <filter name="filter_this_week" string="This Week" domain="[('is_this_week', '=', True)]"/>
                <filter name="filter_this_month" string="This Month" domain="[('is_this_month', '=', True)]"/>
                <separator/>
                <filter name="filter_repeating" string="Repeating Tasks" domain="[('is_daily_repeating', '=', True)]"/>
                <separator/>
                <filter name="filter_not_started" string="Not Started" domain="[('state', '=', 'not_started')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="filter_on_hold" string="On Hold" domain="[('state', '=', 'on_hold')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_stage_id" string="Stage" context="{'group_by': 'stage_id'}"/>
                <filter name="group_state" string="State (Legacy)" context="{'group_by': 'state'}"/>
                <filter name="group_kra" string="KRA" context="{'group_by': 'kra_id'}"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_manager" string="KRA Manager" context="{'group_by': 'manager_id'}"/>
                <filter name="group_employee" string="Assigned Employee" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="business_project_kpi_pivot" model="ir.ui.view">
        <field name="name">business.project.kpi.pivot</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <pivot string="KRA &amp; KPI Analysis">
                <field name="project_id" type="row"/>
                <field name="kra_id" type="row"/>
                <field name="name" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="date" type="col" interval="day"/>
                <field name="progress" type="measure"/>
                <field name="total_hours_spent" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="business_project_kpi_graph" model="ir.ui.view">
        <field name="name">business.project.kpi.graph</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <graph string="KPI Performance" type="bar">
                <field name="kra_id"/>
                <field name="name"/>
                <field name="progress" type="measure"/>
            </graph>
        </field>
    </record>


    <!-- ==========================================
         KRA VIEWS (MAIN TASKS)
    ========================================== -->

    <!-- KRA List View -->
    <record id="business_project_kra_list" model="ir.ui.view">
        <field name="name">business.project.kra.list</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <list string="Key Result Areas (KRAs)">
                <field name="sequence" widget="handle"/>
                <field name="reference"/>
                <field name="name" string="KRA Name"/>
                <field name="project_id" string="Project"/>
                <field name="manager_id" string="KRA Manager"/>
                <field name="priority" widget="priority"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="stage_id" string="Stage" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'ongoing'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'on_hold'"/>
                <field name="kpi_count" string="KPIs Count"/>
                <field name="weekly_progress" widget="progressbar" string="Progress (%)"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- KRA Kanban View -->
    <record id="business_project_kra_kanban" model="ir.ui.view">
        <field name="name">business.project.kra.kanban</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" records_draggable="1">
                <field name="stage_id" options="{'group_by_tooltip': {'description': 'Stage Details'}}"/>
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="kpi_count"/>
                <field name="weekly_progress"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <!-- Top: Priority and State Badge -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <field name="priority" widget="priority"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'new'"
                                       decoration-warning="state == 'ongoing'"
                                       decoration-success="state == 'completed'"
                                       decoration-danger="state == 'on_hold'"/>
                            </div>

                            <!-- KRA Name -->
                            <div class="fw-bold fs-6 text-dark mb-2">
                                <field name="name"/>
                            </div>

                            <!-- Project Name -->
                            <div class="text-muted small mb-2">
                                <i class="fa fa-folder-open-o me-1 text-primary" title="Project"/>
                                <strong><field name="project_id"/></strong>
                            </div>

                            <!-- Progress Bar -->
                            <div class="my-2">
                                <field name="weekly_progress" widget="progressbar"/>
                            </div>

                            <!-- Footer: KRA Manager & KPIs Count -->
                            <div class="d-flex justify-content-between align-items-center text-muted small mt-2 pt-2 border-top">
                                <div class="d-flex align-items-center">
                                    <field name="manager_id" widget="many2one_avatar_user" class="me-1"/>
                                    <span class="text-truncate" style="max-width: 120px;"><field name="manager_id"/></span>
                                </div>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa fa-tasks me-1 text-secondary"/> <field name="kpi_count"/> KPIs
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- KRA Form View -->
    <record id="business_project_kra_form" model="ir.ui.view">
        <field name="name">business.project.kra.form</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <form string="Key Result Area (KRA)">
                <header>
                    <button name="action_set_ongoing" string="Start / Ongoing" type="object"
                            class="btn-primary" invisible="state == 'ongoing'"/>
                    <button name="action_set_completed" string="Mark Completed" type="object"
                            class="btn-success" invisible="state == 'completed'"/>
                    <button name="action_set_on_hold" string="Put On Hold" type="object"
                            class="btn-secondary" invisible="state == 'on_hold'"/>
                    <button name="action_set_new" string="Reset to New" type="object"
                            invisible="state == 'new'"/>
                    <button name="action_generate_daily_repeating_kpis"
                            string="Generate Daily Tasks"
                            type="object"
                            class="btn-link"
                            icon="fa-refresh"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': True}"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- KPI Smart Button: Opens KPI Kanban View Grouped by Stages -->
                        <button name="action_view_kpis" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="kpi_count" widget="statinfo" string="KPIs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="text-muted"><field name="reference" readonly="1"/></span>
                        <h1><field name="name" placeholder="KRA Name"/></h1>
                    </div>
                    <group>
                        <group string="Project &amp; Ownership">
                            <!-- Which project under -->
                            <field name="project_id" string="Project" placeholder="Select Project"/>
                            <!-- KRA Manager -->
                            <field name="manager_id" string="KRA Manager"/>
                            <field name="department_id" decoration-bf="1"/>
                        </group>
                        <group string="Timeline &amp; Priority">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- KPIs Sub-Tasks Page -->
                        <page string="Sub-Tasks (KPIs)" name="kpis">
                            <div class="mb-2">
                                <button name="action_generate_daily_repeating_kpis"
                                        type="object"
                                        string="Add Today's Repeating Tasks"
                                        class="btn btn-secondary btn-sm"
                                        icon="fa-refresh"/>
                            </div>
                            <field name="kpi_ids" context="{'default_kra_id': id, 'default_project_id': project_id, 'default_department_id': department_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="KPI Name"/>
                                    <field name="employee_ids" widget="many2many_tags_avatar" string="Assigned Employees"/>
                                    <field name="is_daily_repeating" string="Repeating?" widget="boolean_toggle"/>
                                    <field name="progress" widget="progressbar" string="Progress"/>
                                    <field name="total_hours_spent" widget="float_time" string="Hours" optional="show"/>
                                    <field name="stage_id" string="Stage" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'not_started'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-success="state == 'completed'"
                                           decoration-info="state == 'on_hold'"
                                           decoration-danger="state == 'cancelled'"/>
                                    <button name="action_set_completed"
                                            type="object"
                                            title="Mark Completed"
                                            icon="fa-check text-success"
                                            invisible="state == 'completed'"/>
                                    <button name="action_set_in_progress"
                                            type="object"
                                            title="Mark In Progress"
                                            icon="fa-play text-warning"
                                            invisible="state == 'in_progress'"/>
                                    <button name="action_set_on_hold"
                                            type="object"
                                            title="Put On Hold"
                                            icon="fa-pause text-secondary"
                                            invisible="state == 'on_hold'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Objective &amp; Description" name="details">
                            <group>
                                <field name="objective" placeholder="Strategic objective or goals of this KRA..."/>
                                <field name="description" placeholder="Additional guidelines or details..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KRA Search View -->
    <record id="business_project_kra_search" model="ir.ui.view">
        <field name="name">business.project.kra.search</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <search string="Key Result Areas">
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <field name="stage_id"/>
                <field name="state"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="state_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="state_ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="state_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="state_on_hold" string="On Hold" domain="[('state', '=', 'on_hold')]"/>
                <separator/>
                <filter name="group_stage_id" string="Stage" context="{'group_by': 'stage_id'}"/>
                <filter name="group_state" string="State (Legacy)" context="{'group_by': 'state'}"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_manager" string="KRA Manager" context="{'group_by': 'manager_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

</odoo>
