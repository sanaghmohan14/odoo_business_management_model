<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="business_project_kra_action" model="ir.actions.act_window">
        <field name="name">KRAs</field>
        <field name="res_model">business.project.kra</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="business_project_kra_entry_action" model="ir.actions.act_window">
        <field name="name">KRA Entries</field>
        <field name="res_model">business.project.kra.entry</field>
        <field name="view_mode">kanban,list,pivot,graph,calendar,form</field>
        <field name="context">{'search_default_group_frequency': 1}</field>
    </record>

    <record id="business_project_kpi_action" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">business.project.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <record id="business_project_kpi_list" model="ir.ui.view">
        <field name="name">business.project.kpi.list</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kra_id"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="measurement_type"/>
                <field name="frequency"/>
                <field name="target"/>
                <field name="achievement"/>
                <field name="performance_percentage" widget="progressbar"/>
                <field name="weighted_contribution" widget="progressbar"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="business_project_kpi_form" model="ir.ui.view">
        <field name="name">business.project.kpi.form</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI Definition">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Scope">
                            <field name="kra_id"/>
                            <field name="project_id"/>
                            <field name="department_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="Measurement">
                            <field name="code"/>
                            <field name="measurement_type"/>
                            <field name="frequency"/>
                            <field name="target"/>
                            <field name="unit"/>
                            <field name="weight" string="Weightage (%)"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="entry_count"/>
                        <field name="achievement"/>
                        <field name="performance_percentage" widget="progressbar"/>
                        <field name="weighted_contribution" widget="progressbar"/>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Performance Entries">
                            <field name="entry_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="period_type"/>
                                    <field name="task_id"/>
                                    <field name="employee_id"/>
                                    <field name="achievement"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_project_kpi_search" model="ir.ui.view">
        <field name="name">business.project.kpi.search</field>
        <field name="model">business.project.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="kra_id"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
            </search>
        </field>
    </record>

    <record id="business_project_kra_list" model="ir.ui.view">
        <field name="name">business.project.kra.list</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="user_id"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="kpi"/>
                <field name="target"/>
                <field name="unit"/>
                <field name="achievement"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="task_completion_percentage" widget="progressbar"/>
                <field name="state"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="business_project_kra_form" model="ir.ui.view">
        <field name="name">business.project.kra.form</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <form string="KRA">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="KRA name"/></h1>
                    </div>
                    <group>
                        <group string="Assignment">
                            <field name="reference"/>
                            <field name="project_id"/>
                            <field name="department_id"/>
                            <field name="user_id"/>
                            <field name="manager_id"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Target">
                            <field name="kpi"/>
                            <field name="target"/>
                            <field name="unit"/>
                            <field name="frequency"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group string="Period">
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                    <group string="Performance" col="4">
                        <field name="entry_count"/>
                        <field name="task_count"/>
                        <field name="completed_task_count"/>
                        <field name="pending_task_count"/>
                        <field name="on_hold_task_count"/>
                        <field name="target"/>
                        <field name="achievement"/>
                        <field name="progress_percentage" widget="progressbar"/>
                        <field name="task_completion_percentage" widget="progressbar"/>
                        <field name="kpi_weight_total" string="Total KPI Weightage (%)"/>
                        <field name="weighted_kpi_score" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="objective"/>
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="KRA Entries">
                            <field name="entry_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="achievement"/>
                                    <field name="unit"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="KPI Definitions">
                            <field name="kpi_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="measurement_type"/>
                                    <field name="frequency"/>
                                    <field name="target"/>
                                    <field name="unit"/>
                                    <field name="weight" string="Weightage (%)"/>
                                    <field name="weighted_contribution" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                        <page string="Project Tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="assigned_employee_id"/>
                                    <field name="performance_status"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_project_kra_kanban" model="ir.ui.view">
        <field name="name">business.project.kra.kanban</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <kanban default_group_by="frequency" class="o_kanban_small_column">
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="target"/>
                <field name="achievement"/>
                <field name="unit"/>
                <field name="progress_percentage"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="label_selection"/>
                            </div>
                            <div class="text-muted"><field name="reference"/> · <field name="project_id"/></div>
                            <div class="mt-2">
                                <span>Target: <field name="target"/> <field name="unit"/></span>
                                <span class="float-end">Done: <field name="achievement"/> <field name="unit"/></span>
                            </div>
                            <field name="progress_percentage" widget="progressbar"/>
                            <div class="text-muted mt-1"><field name="user_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="business_project_kra_search" model="ir.ui.view">
        <field name="name">business.project.kra.search</field>
        <field name="model">business.project.kra</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="group_project" string="Business Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_user" string="Responsible User" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="business_project_kra_entry_list" model="ir.ui.view">
        <field name="name">business.project.kra.entry.list</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="day"/>
                <field name="week_start"/>
                <field name="month_start"/>
                <field name="kra_id"/>
                <field name="kpi_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="period_type"/>
                <field name="frequency"/>
                <field name="target"/>
                <field name="achievement"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="task_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="business_project_kra_entry_kanban" model="ir.ui.view">
        <field name="name">business.project.kra.entry.kanban</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="frequency" class="o_kanban_small_column">
                <field name="kra_id"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="target"/>
                <field name="achievement"/>
                <field name="unit"/>
                <field name="progress_percentage"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="kra_id"/></strong>
                                <field name="state" widget="label_selection"/>
                            </div>
                            <div class="text-muted"><field name="date"/> · <field name="project_id"/></div>
                            <div class="mt-2">
                                <span>Target: <field name="target"/> <field name="unit"/></span>
                                <span class="float-end">Done: <field name="achievement"/> <field name="unit"/></span>
                            </div>
                            <field name="progress_percentage" widget="progressbar"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="business_project_kra_entry_form" model="ir.ui.view">
        <field name="name">business.project.kra.entry.form</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <form string="KRA Entry">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state not in ('submitted', 'rejected')"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted', 'approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kra_id"/>
                            <field name="kpi_id" domain="[('kra_id', '=', kra_id)]"/>
                            <field name="task_id" domain="[('kra_id', '=', kra_id)]"/>
                            <field name="project_id"/>
                            <field name="department_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="period_type"/>
                            <field name="target"/>
                            <field name="achievement"/>
                            <field name="unit"/>
                            <field name="task_status"/>
                            <field name="completion_date"/>
                        </group>
                    </group>
                    <group string="Calculated Performance">
                        <field name="progress_percentage" widget="progressbar"/>
                        <field name="day"/>
                        <field name="week_start"/>
                        <field name="month_start"/>
                    </group>
                    <field name="name" placeholder="What was achieved?"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_project_kra_entry_search" model="ir.ui.view">
        <field name="name">business.project.kra.entry.search</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <search string="KRA Performance">
                <field name="date"/>
                <field name="kra_id"/>
                <field name="kpi_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="period_type"/>
                <field name="state"/>
                <field name="task_status"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today())]"/>
                <filter name="this_week" string="This Week" domain="[('week_start', '=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_month" string="This Month" domain="[('month_start', '=', context_today().replace(day=1).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                <filter name="group_day" string="Day" context="{'group_by': 'day'}"/>
                <filter name="group_week" string="Week" context="{'group_by': 'week_start'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'month_start'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_user" string="Responsible User" context="{'group_by': 'user_id'}"/>
                <filter name="group_project" string="Business Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_kra" string="KRA" context="{'group_by': 'kra_id'}"/>
                <filter name="group_kpi" string="KPI" context="{'group_by': 'kpi_id'}"/>
                <filter name="group_task" string="Task" context="{'group_by': 'task_id'}"/>
                <filter name="group_period" string="Performance Period" context="{'group_by': 'period_type'}"/>
                <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_task_status" string="Task Status" context="{'group_by': 'task_status'}"/>
            </search>
        </field>
    </record>

    <record id="business_project_kra_entry_pivot" model="ir.ui.view">
        <field name="name">business.project.kra.entry.pivot</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <pivot string="KRA Performance">
                <field name="date" type="row" interval="month"/>
                <field name="kra_id" type="row"/>
                <field name="achievement" type="measure"/>
                <field name="progress_percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="business_project_kra_entry_graph" model="ir.ui.view">
        <field name="name">business.project.kra.entry.graph</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <graph string="KRA Performance" type="bar">
                <field name="date" interval="week"/>
                <field name="achievement" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="business_project_kra_entry_calendar" model="ir.ui.view">
        <field name="name">business.project.kra.entry.calendar</field>
        <field name="model">business.project.kra.entry</field>
        <field name="arch" type="xml">
            <calendar string="KRA Entries" date_start="date" color="kra_id">
                <field name="kra_id"/>
                <field name="achievement"/>
                <field name="progress_percentage" widget="progressbar"/>
            </calendar>
        </field>
    </record>

</odoo>
