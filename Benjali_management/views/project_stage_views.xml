<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_project_stage_one" model="ir.actions.act_window">

        <field name="name">Project Stages</field>
        <field name="res_model">business.project.stage</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="project_stage_form_form" model="ir.ui.view">
        <field name="name">Business project Stages</field>
        <field name="model">business.project.stage</field>
        <field name="arch" type="xml">
            <form string="Project Stage">

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>

                    <group>

                        <group>

                            <field name="sequence"/>

                            <field name="phase"/>

                            <field name="active"/>

                            <field name="folded"/>

                            <field name="is_sop_stage"/>

                        </group>
                        <group string="Approval">

                            <field name="requires_approval"/>

                            <field name="approval_type"
                                   invisible="not requires_approval"
                                   required="requires_approval"/>

                            <field name="approver_id"
                                   invisible="not requires_approval"/>

                        </group>

                        <group>
                            <field name="responsible_user_id"/>

                            <field name="responsible_role"/>


                            <field name="approver_role"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Description">

                            <field name="description"
                                   placeholder="Enter the purpose of this stage..."/>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="project_stage_form_tree" model="ir.ui.view">
        <field name="name">Project Stage Tree</field>
        <field name="model">business.project.stage</field>
        <field name="arch" type="xml">
            <list string="Project Stages">

                <field name="sequence" widget="handle"/>

                <field name="name"/>

                <field name="phase"/>

                <field name="responsible_role"/>

                <field name="approver_role"/>

                <field name="active"/>

                <field name="folded"/>

                <field name="is_sop_stage" optional="show"/>

            </list>
        </field>
    </record>

    <!-- ==========================================
         SCOPE STAGES VIEWS & ACTION
    ========================================== -->
    <record id="action_business_project_kra_stage" model="ir.actions.act_window">
        <field name="name">Scope Stages</field>
        <field name="res_model">business.project.kra.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage stages for Project Scopes.
            </p>
        </field>
    </record>

    <record id="business_project_kra_stage_list" model="ir.ui.view">
        <field name="name">business.project.kra.stage.list</field>
        <field name="model">business.project.kra.stage</field>
        <field name="arch" type="xml">
            <list string="Scope Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="folded"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="business_project_kra_stage_form" model="ir.ui.view">
        <field name="name">business.project.kra.stage.form</field>
        <field name="model">business.project.kra.stage</field>
        <field name="arch" type="xml">
            <form string="Scope Stage">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="folded"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Stage Description &amp; Tooltip">
                        <field name="description" placeholder="Brief tooltip description for this stage..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================
         TASK STAGES VIEWS & ACTION
    ========================================== -->
    <record id="action_business_project_kpi_stage" model="ir.actions.act_window">
        <field name="name">Task Stages</field>
        <field name="res_model">business.project.kpi.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage stages for Project Tasks.
            </p>
        </field>
    </record>

    <record id="business_project_kpi_stage_list" model="ir.ui.view">
        <field name="name">business.project.kpi.stage.list</field>
        <field name="model">business.project.kpi.stage</field>
        <field name="arch" type="xml">
            <list string="Task Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="folded"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="business_project_kpi_stage_form" model="ir.ui.view">
        <field name="name">business.project.kpi.stage.form</field>
        <field name="model">business.project.kpi.stage</field>
        <field name="arch" type="xml">
            <form string="Task Stage">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="folded"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Stage Description &amp; Tooltip">
                        <field name="description" placeholder="Brief tooltip description for this stage..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>