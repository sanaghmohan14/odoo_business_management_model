<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_project_stage_one" model="ir.actions.act_window">

        <field name="name">Project Stages</field>
        <field name="res_model">business.project.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="project_stage_form_form" model="ir.ui.view">
        <field name="name">Business project Stages</field>
        <field name="model">business.project.stage</field>
        <field name="arch" type="xml">
            <form string="Project Stage">

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>

                    <group>

                        <group>

                            <field name="sequence"/>

                            <field name="phase"/>

                            <field name="active"/>

                            <field name="folded"/>

                        </group>

                        <group>

                            <field name="responsible_role"/>

                            <field name="approver_role"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Description">

                            <field name="description"
                                   placeholder="Enter the purpose of this stage..."/>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="project_stage_form_tree" model="ir.ui.view">
        <field name="name">Project Stage Tree</field>
        <field name="model">business.project.stage</field>
        <field name="arch" type="xml">
                 <list string="Project Stages">

                <field name="sequence" widget="handle"/>

                <field name="name"/>

                <field name="phase"/>

                <field name="responsible_role"/>

                <field name="approver_role"/>

                <field name="active"/>

                <field name="folded"/>

            </list>
        </field>
    </record>
</odoo>