<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="business_project_approval_action" model="ir.actions.act_window">

        <field name="name">Project Approval</field>
        <field name="res_model">business.project.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="project_approval_form" model="ir.ui.view">
        <field name="name">Project approval form</field>
        <field name="model">business.project.approval</field>
        <field name="arch" type="xml">
            <form string="Approval Request">

                <header>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"
                            invisible="state != 'pending'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"
                            invisible="state != 'pending'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>

                </header>

                <sheet>

                    <div class="oe_title">

                        <h1>

                            <field name="name"/>

                        </h1>

                    </div>

                    <group>

                        <group>

                            <field name="project_id"/>

                            <field name="approval_type"/>

                            <field name="approver_id"/>

                        </group>

                        <group>

                            <field name="requested_by"/>

                            <field name="requested_date"/>

                            <field name="approval_date"/>

                            <field name="company_id"/>

                        </group>

                    </group>

                    <group string="Comments">

                        <field name="comments"
                               placeholder="Enter approval comments..."/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <record id="project_approval_tree" model="ir.ui.view">
        <field name="name">project approval Tree</field>
        <field name="model">business.project.approval</field>
        <field name="arch" type="xml">
            <list string="Approval Requests">

                <field name="name"/>
                <field name="project_id"/>
                <field name="approval_type"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="requested_date"/>
                <field name="approval_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>