<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="project_approval_form" model="ir.ui.view">
        <field name="name">Project approval form</field>
        <field name="model">business.project.approval</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"
                            invisible="state != 'pending'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"
                            invisible="state != 'pending'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="kra_id" invisible="not kra_id"/>
                            <field name="kpi_id" invisible="not kpi_id"/>
                            <field name="subtask_id" invisible="not subtask_id"/>
                            <field name="approval_type"/>
                            <field name="approver_id"/>
                        </group>

                        <group>
                            <field name="requested_by"/>
                            <field name="requested_date"/>
                            <field name="approval_date"/>
                            <field name="company_id"/>
                        </group>
                    </group>

                    <group string="Comments">
                        <field name="comments"
                               placeholder="Enter approval comments..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="project_approval_tree" model="ir.ui.view">
        <field name="name">project approval Tree</field>
        <field name="model">business.project.approval</field>
        <field name="arch" type="xml">
            <list string="Approval Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="kra_id" optional="show"/>
                <field name="kpi_id" optional="show"/>
                <field name="subtask_id" optional="show"/>
                <field name="approval_type"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="requested_date"/>
                <field name="approval_date"/>
                <field name="state"
                       widget="badge"
                       decoration-danger="state == 'rejected'"
                       decoration-success="state ==  'approved'"
                       decoration-warning="state == 'pending'"/>
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-success btn-sm"
                        icon="fa-check"
                        invisible="state != 'pending'"/>
                <button name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn-danger btn-sm"
                        icon="fa-times"
                        invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Search View (Must be before action referencing it) -->
    <record id="project_approval_search" model="ir.ui.view">
        <field name="name">business.project.approval.search</field>
        <field name="model">business.project.approval</field>
        <field name="arch" type="xml">
            <search string="Search Approval Requests">
                <field name="name" string="Reference"/>
                <field name="project_id"/>
                <field name="kra_id"/>
                <field name="kpi_id"/>
                <field name="subtask_id"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Waiting for My Approval" name="to_approve" domain="[('approver_id', '=', uid), ('state', '=', 'pending')]"/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Approval Type" name="group_type" context="{'group_by': 'approval_type'}"/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                <filter string="Approver" name="group_approver" context="{'group_by': 'approver_id'}"/>
                <filter string="Requested By" name="group_requested_by" context="{'group_by': 'requested_by'}"/>
            </search>
        </field>
    </record>

    <!-- Action Window (Defined AFTER search_view and other views) -->
    <record id="business_project_approval_action" model="ir.actions.act_window">
        <field name="name">Project Approval</field>
        <field name="res_model">business.project.approval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_approval_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval requests found!
            </p>
            <p>
                Approval requests for Project stages, Scope completion, Task completion, and Subtasks will appear here.
            </p>
        </field>
    </record>

</odoo>
