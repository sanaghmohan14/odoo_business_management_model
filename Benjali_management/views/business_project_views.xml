<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="business_project_action" model="ir.actions.act_window">

        <field name="name">Business Project</field>
        <field name="res_model">business.project</field>
        <field name="view_mode">kanban,list,form,calendar</field>
    </record>

    <record id="project_kanban" model="ir.ui.view">
        <field name="name">Business Project Pipeline</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column o_opportunity_kanban"
                    archivable="false">

                <field name="stage_id"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="opportunity_id"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <field name="active"/>

                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted">
                            <field name="reference"/>
                        </div>
                        <div t-if="record.opportunity_id.raw_value"
                             class="mt-2">
                            <strong>Opportunity: </strong>
                            <field name="opportunity_id"/>
                        </div>
                        <div t-if="record.partner_id.raw_value">
                            <strong>Client: </strong>
                            <field name="partner_id"/>
                        </div>
                        <div t-if="record.department_id.raw_value">
                            <strong>Department: </strong>
                            <field name="department_id"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_form_form" model="ir.ui.view">
        <field name="name">Business project</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <form string="Business Project">

                <!-- ================= HEADER ================= -->

                <header>

                    <button name="action_previous_stage"
                            string="Previous Stage"
                            type="object"
                            class="btn-secondary"
                            icon="fa-arrow-left"
                            invisible="is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_next_stage"
                            string="Next Stage"
                            type="object"
                            class="btn-primary"
                            icon="fa-arrow-right"
                            invisible="is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_hold"
                            string="Put On Hold"
                            type="object"
                            class="btn-secondary"
                            icon="fa-pause"
                            invisible="is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_resume"
                            string="Resume"
                            type="object"
                            class="btn-primary"
                            icon="fa-play"
                            invisible="not is_on_hold"/>

<!--                    <button name="action_complete"-->
<!--                            string="Complete"-->
<!--                            type="object"-->
<!--                            class="btn-primary"-->
<!--                            icon="fa-check"-->
<!--                            invisible="is_completed or is_cancelled or is_on_hold"/>-->

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"
                            invisible="is_cancelled or is_completed"/>

                    <!-- Workflow status -->
                    <field name="stage_id"
                           widget="statusbar"
                           options="{'clickable': False}"/>

                </header>


                <!-- ================= FORM BODY ================= -->

                <sheet>

                    <!-- Title -->
                    <div class="oe_title">

                        <label for="name"
                               class="oe_edit_only"
                               string="Project Name"/>

                        <h1>
                            <field name="name"
                                   placeholder="Enter project name..."/>
                        </h1>

                    </div>


                    <!-- ================= BASIC INFORMATION ================= -->

                    <group string="Project Information">

                        <group>

                            <field name="reference"
                                   readonly="1"/>

                            <field name="partner_id"/>

                            <field name="department_id"
                                   readonly="1"/>

                            <field name="stage_id"/>

                            <field name="phase"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="start_date"/>

                            <field name="expected_end_date"/>

                            <field name="actual_end_date"
                                   readonly="1"/>

                            <field name="active"/>

                        </group>

                    </group>


                    <!-- ================= SALES INFORMATION ================= -->

                    <group string="Sales &amp; CRM">

                        <group>

                            <field name="opportunity_id"/>

                            <field name="sale_order_id"/>

                        </group>

                        <group>

                            <field name="sales_person_id"/>

                            <field name="responsible_user_id"/>

                        </group>

                    </group>


                         <group string="Lead Qualification">

                                <field name="qualification_status"/>

                                <field  name="qualification_notes"
                                placeholder="Enter qualification details..."/>

                         </group>


                    <!-- ================= PROJECT INFORMATION ================= -->

                    <group string="Project">

                        <group>

                            <field name="project_id"/>

                        </group>

                        <group>

                            <field name="project_manager_id"/>

                        </group>

                    </group>

                    <group string="Project Communication">
                        <field name="communication_channel"/>
                         <field name="communication_group_name"/>
                        <field name="communication_created"/>
                        <field name="communication_notes"/>
                    </group>


                    <!-- ================= WORKFLOW INFORMATION ================= -->

                    <group string="Workflow Information">

                        <group>

                            <field name="previous_stage_id"
                                   readonly="1"/>

                            <field name="hold_return_stage_id"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="stage_sequence"
                                   readonly="1"/>

                        </group>

                    </group>
                    <group string="Client Kick-off">
    <field name="kickoff_contact_date"/>
    <field name="kickoff_date"/>
    <field name="kickoff_completed"/>
    <field name="kickoff_notes"/>
</group>


                    <!-- ================= DESCRIPTION ================= -->

                    <notebook>

                        <page string="Description">
                            <field name="description" placeholder="Enter project description..."/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"
                                   placeholder="Enter internal notes..."/>
                        </page>
                        <page string="Approvals">
                            <field name="approval_ids"
                                        readonly="1">

            <list>

                <field name="name"/>
                <field name="approval_type"/>
                <field name="approver_id"/>
                <field name="requested_date"/>
                <field name="approval_date"/>
                <field name="state"/>

        </list>

    </field>

</page>
                        <page string="Team Allocation">
    <field name="team_member_ids">
        <list editable="bottom">
            <field name="user_id"/>
            <field name="role"/>
            <field name="notes"/>
        </list>
    </field>
</page>
                        <page string="KRA">
    <field name="kra_ids">
        <list editable="bottom">
            <field name="sequence"/>
            <field name="name"/>
            <field name="objective"/>
            <field name="responsible_user_id"/>
            <field name="target"/>
            <field name="measurement"/>
        </list>
    </field>
</page>

                        <page string="Data Collection">
    <field name="data_collection_ids">
        <list editable="bottom">
            <field name="name"/>
            <field name="data_type"/>
            <field name="responsible_user_id"/>
            <field name="collection_date"/>
            <field name="source"/>
            <field name="state"/>
            <field name="notes"/>
        </list>
    </field>
</page>

                    </notebook>


                </sheet>


                <!-- ================= CHATTER ================= -->

                <chatter>

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </chatter>

            </form>

        </field>
    </record>

    <record id="project_form_tree" model="ir.ui.view">
        <field name="name">Project Tree</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
                <list string="Business Projects"
                  default_order="id desc">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="phase"/>
                <field name="sales_person_id"/>
                <field name="project_manager_id"/>
                <field name="start_date"/>
                <field name="expected_end_date"/>
                <field name="actual_end_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="business_project_calendar" model="ir.ui.view">
        <field name="name">Business Project Calendar</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <calendar string="Business Projects"
                      date_start="start_date"
                      date_stop="expected_end_date"
                      color="partner_id"
                      mode="month">
                <field name="name"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="department_id"/>
            </calendar>
        </field>
    </record>

</odoo>
