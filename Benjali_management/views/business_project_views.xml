<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="business_project_action" model="ir.actions.act_window">

        <field name="name">Business Project</field>
        <field name="res_model">business.project</field>
        <field name="view_mode">kanban,list,form,calendar</field>
    </record>

    <record id="project_kanban" model="ir.ui.view">
        <field name="name">Business Project Pipeline</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column o_opportunity_kanban"
                    archivable="false">

                <field name="stage_id"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="opportunity_id"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <field name="active"/>
                <field name="priority"/>
                <field name="activity_ids"/>

                <templates>
                    <t t-name="card">

                        <field name="name" class="fw-bold fs-5"/>

                        <div class="text-muted">
                            <field name="reference"/>
                        </div>

                        <div t-if="record.opportunity_id.raw_value"
                             class="mt-2">
                            <strong>Opportunity:</strong>
                            <field name="opportunity_id"/>
                        </div>

                        <div t-if="record.partner_id.raw_value">
                            <strong>Client:</strong>
                            <field name="partner_id"/>
                        </div>

                        <div t-if="record.department_id.raw_value">
                            <strong>Department:</strong>
                            <field name="department_id"/>
                        </div>

                        <footer class="pt-1 mt-2">
                            <div class="d-flex align-items-center">
                                <field name="priority" widget="priority" class="me-2"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </footer>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <record id="project_form_form" model="ir.ui.view">
        <field name="name">Business project</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <form string="Business Project">

                <!-- ================= HEADER ================= -->

                <header>

                    <button name="action_previous_stage"
                            string="Previous Stage"
                            type="object"
                            class="btn-secondary"
                            icon="fa-arrow-left"
                            invisible="is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_request_approval"
                            string="Request CEO Approval"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="not stage_requires_approval or has_pending_approval or is_stage_approved or is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_approve_pending"
                            string="Approve (CEO)"
                            type="object"
                            class="btn-success"
                            icon="fa-check"
                            invisible="not has_pending_approval or not is_current_user_ceo or is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_reject_pending"
                            string="Reject (CEO)"
                            type="object"
                            class="btn-danger"
                            icon="fa-times"
                            invisible="not has_pending_approval or not is_current_user_ceo or is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_next_stage"
                            string="Next Stage"
                            type="object"
                            class="btn-primary"
                            icon="fa-arrow-right"
                            invisible="is_on_hold or is_cancelled or is_completed or (stage_requires_approval and not is_stage_approved)"/>

                    <button name="action_hold"
                            string="Hold"
                            type="object"
                            class="btn-secondary"
                            icon="fa-pause"
                            invisible="is_on_hold or is_cancelled or is_completed"/>

                    <button name="action_resume"
                            string="Resume"
                            type="object"
                            class="btn-primary"
                            icon="fa-play"
                            invisible="not is_on_hold"/>

                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="btn-success"
                            icon="fa-check"
                            invisible="is_completed or is_cancelled or is_on_hold"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"
                            invisible="is_cancelled or is_completed"/>

                    <!-- Workflow status -->
                    <field name="stage_id"
                           widget="statusbar"
                           options="{'clickable': False}"/>
                    <field name="is_team_allocation_stage" invisible="1"/>
                    <field name="is_kickoff_stage" invisible="1"/>
                    <field name="is_communication_stage" invisible="1"/>
                    <field name="is_client_onboarding_stage" invisible="1"/>
                    <field name="is_sop_active_stage" invisible="1"/>
                    <field name="is_sop_required" invisible="1"/>
                    <field name="stage_requires_approval" invisible="1"/>
                    <field name="has_pending_approval" invisible="1"/>
                    <field name="is_stage_approved" invisible="1"/>
                    <field name="is_current_user_ceo" invisible="1"/>

                </header>


                <!-- ================= FORM BODY ================= -->

                <sheet>

                    <div class="alert alert-warning text-center" role="alert"
                         invisible="not has_pending_approval">
                        <strong>Approval Pending:</strong> This project is currently waiting for CEO review and approval before proceeding to the next stage.
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project_kras"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="kra_count"
                                   widget="statinfo"
                                   string="KRAs"/>
                        </button>
                        <button name="action_view_project_kpis"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-square-o">
                            <field name="kpi_count"
                                   widget="statinfo"
                                   string="KPIs"/>
                        </button>
                        <button name="action_view_meetings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="meeting_count"
                                   widget="statinfo"
                                   string="Meetings"/>
                        </button>
                        <button name="action_view_activity_calendar"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <span class="o_stat_text">Activities</span>
                        </button>
                    </div>
                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Enter project name..."/>
                        </h1>
                    </div>
                    <!-- ================= BASIC INFORMATION ================= -->
                    <group>
                        <group>
                            <field name="reference"
                                   readonly="1"/>
                            <field name="partner_id"/>
                            <field name="department_id"
                                   readonly="1"/>
                            <field name="priority" widget="priority"/>
                            <!--                            <field name="stage_id"/>-->
                            <field name="project_manager_id"/>
                            <field name="responsible_user_id"/>
                            <field name="phase"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expected_end_date"/>
                            <field name="actual_end_date"
                                   readonly="1"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>

                    </group>

                    <notebook>

                        <!-- ================= KRA & KPI MANAGEMENT ================= -->
                        <page string="KRAs &amp; KPIs" name="kra_kpi_page">
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded border">
                                <div>
                                    <button name="action_generate_today_kpis"
                                            type="object"
                                            string="Generate Today's Repeating Tasks"
                                            class="btn btn-primary btn-sm me-2"
                                            icon="fa-refresh"/>
                                </div>
                                <div class="d-flex gap-3 align-items-center">
                                    <span class="text-muted small">Weekly Progress:</span>
                                    <field name="kra_weekly_progress" widget="progressbar" class="oe_inline" style="width: 140px;"/>
                                    <span class="text-muted small">Monthly Score (/100):</span>
                                    <field name="kra_monthly_progress" widget="progressbar" class="oe_inline" style="width: 140px;"/>
                                </div>
                            </div>

                            <group string="Key Result Areas (KRAs) - Main Tasks">
                                <field name="kra_ids" nolabel="1" context="{'default_project_id': id, 'default_department_id': department_id}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="reference" readonly="1"/>
                                        <field name="name" string="KRA Name"/>
                                        <field name="manager_id" string="KRA Manager"/>
                                        <field name="priority" widget="priority"/>
                                        <field name="stage_id" string="Stage" optional="show"/>
                                        <field name="state" widget="badge"
                                               decoration-info="state == 'new'"
                                               decoration-warning="state == 'ongoing'"
                                               decoration-success="state == 'completed'"
                                               decoration-danger="state == 'on_hold'"/>
                                        <field name="kpi_count" string="KPIs Count"/>
                                        <field name="weekly_progress" widget="progressbar" string="Progress (%)"/>
                                        <button name="action_generate_daily_repeating_kpis"
                                                type="object"
                                                title="Generate Today's Repeating Tasks"
                                                icon="fa-refresh"
                                                class="btn-link"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Key Performance Indicators (KPIs) - Sub-Tasks">
                                <field name="kpi_ids" nolabel="1" context="{'default_project_id': id, 'default_department_id': department_id}">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <field name="kra_id" domain="parent.id and [('project_id', '=', parent.id)] or []" string="KRA"/>
                                        <field name="name" string="KPI Name"/>
                                        <field name="employee_ids" widget="many2many_tags_avatar" string="Assigned Employees"/>
                                        <field name="is_daily_repeating" string="Repeating?" widget="boolean_toggle"/>
                                        <field name="progress" widget="progressbar" string="Progress"/>
                                        <field name="stage_id" string="Stage" optional="show"/>
                                        <field name="state" widget="badge"
                                               decoration-muted="state == 'not_started'"
                                               decoration-warning="state == 'in_progress'"
                                               decoration-success="state == 'completed'"
                                               decoration-info="state == 'on_hold'"
                                               decoration-danger="state == 'cancelled'"/>
                                        <button name="action_set_completed"
                                                type="object"
                                                title="Mark Completed"
                                                icon="fa-check text-success"
                                                invisible="state == 'completed'"/>
                                        <button name="action_set_in_progress"
                                                type="object"
                                                title="Mark In Progress"
                                                icon="fa-play text-warning"
                                                invisible="state == 'in_progress'"/>
                                        <button name="action_set_on_hold"
                                                type="object"
                                                title="Put On Hold"
                                                icon="fa-pause text-secondary"
                                                invisible="state == 'on_hold'"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Notes">
                            <field name="description" placeholder="Enter project description..."/>
                        </page>

                        <page string="Activity Plan">
                            <field name="activity_plan_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="responsible_user_id"/>
                                    <field name="planned_start"/>
                                    <field name="planned_end"/>
                                    <field name="priority"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approvals">
                            <field name="approval_ids">
                                <list create="false">
                                    <field name="name"/>
                                    <field name="approval_type"/>
                                    <field name="requested_by"/>
                                    <field name="approver_id"/>
                                    <field name="requested_date"/>
                                    <field name="approval_date"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-danger="state == 'rejected'"
                                           decoration-success="state == 'approved'"
                                           decoration-warning="state == 'pending'"/>
                                    <button name="action_approve"
                                            string="Approve"
                                            type="object"
                                            class="btn-success btn-sm"
                                            icon="fa-check"
                                            invisible="state != 'pending'"/>
                                    <button name="action_reject"
                                            string="Reject"
                                            type="object"
                                            class="btn-danger btn-sm"
                                            icon="fa-times"
                                            invisible="state != 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Team Allocation" invisible="not is_team_allocation_stage">
                            <field name="team_member_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="role"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
<!--                        <page string="Timesheets">-->
<!--                            <field name="timesheet_ids">-->
<!--                                <list editable="bottom">-->
<!--                                    <field name="date"/>-->
<!--                                    <field name="employee_id"/>-->
<!--                                    <field name="name"/>-->
<!--                                    <field name="unit_amount"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                        <page string="Client Kick Off" invisible="not is_kickoff_stage">
                            <group>
                                <field name="kickoff_contact_date" string="Initial Client Contact"/>
                                <field name="kickoff_date" string="Kick-off Date"/>
                                <field name="kickoff_completed" string="Kick-off Completed"/>
                                <field name="kickoff_notes" string="Kick-off Notes"/>
                            </group>

                        </page>

                        <page string="Tasks">
                            <field name="task_ids" context="{'default_business_project_id': id, 'default_project_id': project_id}">
                                <list editable="bottom">
                                    <field name="name" string="Task"/>
                                    <field name="user_ids" string="Assignees" widget="many2many_tags"/>
<!--                                    <field name="completed" string="completed"/>-->
                                </list>
                            </field>
                        </page>

                        <page string="Communication" invisible="not is_communication_stage">
                            <group string="Project Communication">
                                <field name="communication_channel"/>
                                <field name="communication_group_name"/>
                                <field name="communication_created"/>
                                <field name="communication_notes"/>
                                <button name="action_send_email"
                                        string="Send Email"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-envelope"
                                        invisible="communication_channel != 'email'"/>
                            </group>
                        </page>

                        <page string="Data Collection">
                            <field name="data_collection_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="data_type"/>
                                    <field name="responsible_user_id"/>
                                    <field name="collection_date"/>
                                    <field name="source"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                    </notebook>


                </sheet>


                <!-- ================= CHATTER ================= -->

                <chatter>

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </chatter>

            </form>

        </field>
    </record>

    <record id="project_form_tree" model="ir.ui.view">
        <field name="name">Project Tree</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <list string="Business Projects"
                  default_order="id desc">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="phase"/>
                <field name="priority" widget="priority"/>
                <field name="responsible_user_id"/>
                <field name="client_implementation_coordinator_id"/>
                <field name="start_date"/>
                <field name="expected_end_date"/>
                <field name="actual_end_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="business_project_calendar" model="ir.ui.view">
        <field name="name">Business Project Calendar</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <calendar string="Business Projects"
                      date_start="start_date"
                      date_stop="expected_end_date"
                      color="partner_id"
                      mode="month">
                <field name="name"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="department_id"/>
            </calendar>
        </field>
    </record>

    <record id="business_project_activity_calendar" model="ir.ui.view">
        <field name="name">Business Project Activity Calendar</field>
        <field name="model">business.project.activity</field>
        <field name="arch" type="xml">
            <calendar string="Project Activities"
                      date_start="planned_start"
                      date_stop="planned_end"
                      color="responsible_user_id"
                      mode="month">
                <field name="name"/>
                <field name="project_id"/>
                <field name="responsible_user_id"/>
                <field name="state"/>
                <field name="priority"/>
            </calendar>
        </field>
    </record>

    <record id="business_project_search_views" model="ir.ui.view">
        <field name="name">business.project.view.search</field>
        <field name="model">business.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="stage_id"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="opportunity_id"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <field name="active"/>
                <filter name="stage_id" string="filter by stage"/>
                <filter name="Active" string="archived" domain="[('active', '=', False)]"/>
                <filter name="actual_end_date" string="filter by End date" context="{'group_by':'actual_end_date'}"/>
                <filter name="start_date" string="filter by start date" context="{'group_by':'start_date'}"/>
            </search>
        </field>
    </record>

</odoo>
