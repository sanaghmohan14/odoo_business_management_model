<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_kanban_department" model="ir.ui.view">
        <field name="name">project.project.kanban.department</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/div[hasclass('d-flex')]/field[@name='partner_id']" position="after">
                <field name="department_id" string="Department"/>
            </xpath>
        </field>
    </record>
</odoo>
