<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Departments Action -->
    <record id="action_business_departments"
            model="ir.actions.act_window">

        <field name="name">Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,form</field>

    </record>


    <!-- Department Kanban -->
    <record id="view_hr_department_business_project_kanban"
            model="ir.ui.view">

        <field name="name">hr.department.business.project.kanban</field>

        <field name="model">hr.department</field>

        <field name="arch" type="xml">

            <kanban>

                <field name="name"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <div class="fw-bold fs-4 mb-2">
                                <field name="name"/>
                            </div>

                            <div class="text-muted">
                                Business Projects
                            </div>

                            <div class="mt-3">

                                <button
                                    name="action_open_business_projects"
                                    type="object"
                                    string="Open Projects"
                                    class="btn btn-primary"
                                />

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>

    </record>


    <!-- Department List -->
    <record id="view_hr_department_business_project_list"
            model="ir.ui.view">

        <field name="name">hr.department.business.project.list</field>

        <field name="model">hr.department</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>

            </list>

        </field>

    </record>

</odoo>