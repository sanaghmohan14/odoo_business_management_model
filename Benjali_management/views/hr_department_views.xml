<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Departments Action -->
    <record id="action_business_departments"
            model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Department performance, KRAs, KPIs, and Business Projects.
            </p>
        </field>
    </record>


    <!-- Department Kanban -->
    <record id="view_hr_department_business_project_kanban"
            model="ir.ui.view">
        <field name="name">hr.department.business.project.kanban</field>
        <field name="model">hr.department</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="project_count"/>
                <field name="kra_count"/>
                <field name="kpi_count"/>
                <field name="avg_kra_progress"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold fs-4 text-primary">
                                    <field name="name"/>
                                </span>
                                <span class="badge rounded-pill bg-light text-dark border">
                                    <field name="project_count"/> Projects
                                </span>
                            </div>

                            <div class="my-2 p-2 bg-light rounded">
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>KRA Progress</span>
                                    <strong class="text-dark"><field name="avg_kra_progress"/>%</strong>
                                </div>
                                <field name="avg_kra_progress" widget="progressbar"/>
                            </div>

                            <div class="d-flex justify-content-between text-muted small my-2">
                                <span><i class="fa fa-bullseye me-1 text-info"/><strong><field name="kra_count"/></strong> KRAs</span>
                                <span><i class="fa fa-tachometer me-1 text-warning"/><strong><field name="kpi_count"/></strong> KPIs</span>
                            </div>

                            <div class="d-flex gap-2 mt-3 pt-2 border-top">
                                <button name="action_open_business_projects" type="object"
                                        class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="fa fa-folder-open me-1"/>Projects
                                </button>
                                <button name="action_open_department_kras" type="object"
                                        class="btn btn-sm btn-outline-info flex-fill">
                                    <i class="fa fa-bullseye me-1"/>KRAs
                                </button>
                                <button name="action_open_department_kpis" type="object"
                                        class="btn btn-sm btn-outline-secondary flex-fill">
                                    <i class="fa fa-tasks me-1"/>KPIs
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Department List -->
    <record id="view_hr_department_business_project_list"
            model="ir.ui.view">
        <field name="name">hr.department.business.project.list</field>
        <field name="model">hr.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="manager_id"/>
                <field name="project_count" string="Projects"/>
                <field name="kra_count" string="KRAs"/>
                <field name="kpi_count" string="KPIs"/>
                <field name="avg_kra_progress" widget="progressbar" string="Avg KRA Score"/>
            </list>
        </field>
    </record>

    <!-- Department Form Inherit for KRAs and KPIs -->
    <record id="view_hr_department_form_inherit_kra"
            model="ir.ui.view">
        <field name="name">hr.department.form.inherit.kra</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_department_kras" type="object"
                            string="Department KRAs" class="btn-primary"/>
                    <button name="action_open_department_kpis" type="object"
                            string="Department KPIs" class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_business_projects" type="object"
                        class="oe_stat_button" icon="fa-folder-open">
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
                <button name="action_open_department_kras" type="object"
                        class="oe_stat_button" icon="fa-bullseye">
                    <field name="kra_count" widget="statinfo" string="KRAs"/>
                </button>
                <button name="action_open_department_kpis" type="object"
                        class="oe_stat_button" icon="fa-tachometer">
                    <field name="kpi_count" widget="statinfo" string="KPIs"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Department KRAs" name="page_department_kras">
                        <field name="kra_ids">
                            <list editable="bottom">
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="responsible_user_id"/>
                                <field name="target"/>
                                <field name="unit"/>
                                <field name="frequency"/>
                                <field name="kpi_count" string="KPIs"/>
                                <field name="progress_percentage" widget="progressbar"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Department KPIs" name="page_department_kpis">
                        <field name="kpi_ids">
                            <list editable="bottom">
                                <field name="code"/>
                                <field name="name"/>
                                <field name="kra_id"/>
                                <field name="employee_id"/>
                                <field name="frequency"/>
                                <field name="target"/>
                                <field name="unit"/>
                                <field name="weight" string="Weight (%)"/>
                                <field name="performance_percentage" widget="progressbar"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>