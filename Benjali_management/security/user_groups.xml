<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_business_management">
        <field name="name">Business Management</field>
        <field name="sequence">7</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_business_management">
        <field name="name">Business Management</field>
        <field name="category_id" ref="module_category_business_management"/>
    </record>

    <record id="group_assigned_consultant" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="res_groups_privilege_business_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_Team_lead" model="res.groups">
        <field name="name">Team Lead / Project Responsible</field>
        <field name="privilege_id" ref="res_groups_privilege_business_management"/>
        <field name="implied_ids" eval="[(4, ref('group_assigned_consultant'))]"/>
    </record>

    <record id="group_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_business_management"/>
        <field name="implied_ids" eval="[(4, ref('group_Team_lead'))]"/>
    </record>

    <record id="group_gvp" model="res.groups">
        <field name="name">VP</field>
        <field name="privilege_id" ref="res_groups_privilege_business_management"/>
        <field name="implied_ids" eval="[(4, ref('group_project_manager'))]"/>
    </record>

    <record id="group_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="privilege_id" ref="res_groups_privilege_business_management"/>
        <field name="implied_ids" eval="[(4, ref('group_gvp'))]"/>
    </record>

</odoo>