<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groups -->


        <record model="ir.module.category" id="module_hr_management">
            <field name="name">Man Power Management</field>
            <field name="sequence">7</field>
        </record>


        <record model="res.groups.privilege" id="res_groups_privilege_hr_management">
            <field name="name">Man Power Management</field>
            <field name="category_id" ref="module_hr_management"/>
        </record>

        <record id="group_mpr_dept_head" model="res.groups">
            <field name="name">Department Head</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_management"/>
        </record>


        <record id="group_mpr_hr_exec" model="res.groups">
            <field name="name">HR Executive</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_management"/>
        </record>


        <record id="group_mpr_hr_manager" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_management"/>
        </record>


        <record id="group_mpr_management" model="res.groups">
            <field name="name">Approver</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_management"/>
        </record>


        <!-- Record rules -->
        <record id="rule_mpr_company" model="ir.rule">
            <field name="name">Manpower Requisition: multi-company</field>
            <field name="model_id" ref="model_manpower_requisition"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_mpr_dept_head" model="ir.rule">
            <field name="name">Manpower Requisition: department head sees own department</field>
            <field name="model_id" ref="model_manpower_requisition"/>
            <field name="groups" eval="[(4, ref('group_mpr_dept_head'))]"/>
            <field name="domain_force">['|', ('requested_by', '=', user.id), ('head_user_id', '=', user.id)]</field>
        </record>

        <record id="rule_mpr_hr_management" model="ir.rule">
            <field name="name">Manpower Requisition: HR and Management see all</field>
            <field name="model_id" ref="model_manpower_requisition"/>
            <field name="groups" eval="[(4, ref('group_mpr_hr_exec')), (4, ref('group_mpr_management'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_hrx_emp_doc_company" model="ir.rule">
            <field name="name">Employee Document: multi-company</field>
            <field name="model_id" ref="model_hrx_emp_doc"/>
            <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in',
                company_ids)]
            </field>
        </record>

        <record id="rule_hrx_event_company" model="ir.rule">
            <field name="name">Lifecycle Event: multi-company</field>
            <field name="model_id" ref="model_hrx_employee_event"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
