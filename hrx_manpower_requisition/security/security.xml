        <!-- ========================================================= -->
        <!-- Record Rules: Manpower Requisition                        -->
        <!-- ========================================================= -->
        <record id="rule_mpr_company" model="ir.rule">
            <field name="name">Manpower Requisition: multi-company</field>
            <field name="model_id" ref="model_manpower_requisition"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_mpr_employee" model="ir.rule">
            <field name="name">Manpower Requisition: employee sees own or department</field>
            <field name="model_id" ref="model_manpower_requisition"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('requested_by', '=', user.id), ('head_user_id', '=', user.id)]</field>
        </record>

        <record id="rule_mpr_hr_ceo" model="ir.rule">
            <field name="name">Manpower Requisition: HR and CEO see all</field>
            <field name="model_id" ref="model_manpower_requisition"/>
            <field name="groups" eval="[(4, ref('group_hrx_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

