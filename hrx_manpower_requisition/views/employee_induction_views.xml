<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM -->
    <record id="view_hrx_induction_form" model="ir.ui.view">
        <field name="name">hrx.employee.induction.form</field>
        <field name="model">hrx.employee.induction</field>
        <field name="arch" type="xml">
            <form string="Induction &amp; Training">
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary"
                            invisible="state != 'pending'" groups="hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_complete" string="Mark Completed" type="object" class="btn-primary"
                            invisible="state not in ('pending', 'in_progress')"
                            groups="hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_employee_ack" string="Acknowledge Policy / Training" type="object"
                            class="btn-secondary" invisible="employee_acknowledged"/>
                    <button name="action_waive" string="Waive Item" type="object"
                            invisible="state in ('completed', 'waived')"
                            groups="hrx_manpower_requisition.group_hrx_hr,hrx_manpower_requisition.group_hrx_ceo"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. HR Policies &amp; Code of Conduct"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="category"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="date_scheduled"/>
                            <field name="completion_date"/>
                            <field name="employee_acknowledged"/>
                            <field name="ack_date" invisible="not employee_acknowledged"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Instructions &amp; Coverage">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Notes &amp; Feedback">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_hrx_induction_list" model="ir.ui.view">
        <field name="name">hrx.employee.induction.list</field>
        <field name="model">hrx.employee.induction</field>
        <field name="arch" type="xml">
            <list string="Induction Checklist" decoration-success="state == 'completed'" decoration-muted="state == 'waived'">
                <field name="employee_id"/>
                <field name="category"/>
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="date_scheduled"/>
                <field name="completion_date"/>
                <field name="employee_acknowledged" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_hrx_induction_search" model="ir.ui.view">
        <field name="name">hrx.employee.induction.search</field>
        <field name="model">hrx.employee.induction</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="category"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_hrx_induction_my" model="ir.actions.act_window">
        <field name="name">My Induction &amp; Training</field>
        <field name="res_model">hrx.employee.induction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_hrx_induction_all" model="ir.actions.act_window">
        <field name="name">All Inductions &amp; Training</field>
        <field name="res_model">hrx.employee.induction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>
</odoo>
