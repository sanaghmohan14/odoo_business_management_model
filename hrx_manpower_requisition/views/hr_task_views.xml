<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM -->
    <record id="view_hrx_hr_task_form" model="ir.ui.view">
        <field name="name">hrx.hr.task.form</field>
        <field name="model">hrx.hr.task</field>
        <field name="arch" type="xml">
            <form string="HR Task">
                <header>
                    <button name="action_start" string="Start Task" type="object" class="btn-primary"
                            invisible="state not in ('created', 'assigned')"/>
                    <button name="action_complete" string="Mark Completed" type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_verify" string="Verify (CEO/Lead)" type="object" class="btn-primary"
                            invisible="state != 'completed'"
                            groups="hrx_manpower_requisition.group_hrx_ceo,hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_close" string="Close Task" type="object" class="btn-secondary"
                            invisible="state != 'verified'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="created,in_progress,completed,verified,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Audit monthly attendance anomalies"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="task_type"/>
                            <field name="assigned_to"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="is_overdue" widget="boolean" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Task Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Remarks &amp; Outcome" invisible="state in ('created', 'assigned')">
                        <field name="remarks" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_hrx_hr_task_list" model="ir.ui.view">
        <field name="name">hrx.hr.task.list</field>
        <field name="model">hrx.hr.task</field>
        <field name="arch" type="xml">
            <list string="HR Tasks" decoration-danger="is_overdue" decoration-success="state in ('verified', 'closed')">
                <field name="name"/>
                <field name="task_type"/>
                <field name="assigned_to"/>
                <field name="priority" widget="priority"/>
                <field name="date_deadline"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('created', 'assigned')"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('completed', 'verified', 'closed')"/>
            </list>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_hrx_hr_task_search" model="ir.ui.view">
        <field name="name">hrx.hr.task.search</field>
        <field name="model">hrx.hr.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assigned_to"/>
                <field name="task_type"/>
                <filter name="my_tasks" string="My Tasks" domain="[('assigned_to', '=', uid)]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="daily" string="Daily Tasks" domain="[('task_type', '=', 'daily')]"/>
                <filter name="weekly" string="Weekly Tasks" domain="[('task_type', '=', 'weekly')]"/>
                <filter name="monthly" string="Monthly Tasks" domain="[('task_type', '=', 'monthly')]"/>
                <separator/>
                <filter name="open" string="Open Tasks" domain="[('state', 'not in', ('closed', 'cancelled'))]"/>
                <group>
                    <filter name="group_assignee" string="Assigned To" context="{'group_by': 'assigned_to'}"/>
                    <filter name="group_type" string="Cadence" context="{'group_by': 'task_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_hrx_hr_task" model="ir.actions.act_window">
        <field name="name">HR Tasks</field>
        <field name="res_model">hrx.hr.task</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
