<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_form_inherit_hrx" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.hrx</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Candidate Details"
                       groups="hr_recruitment.group_hr_recruitment_user">
                    <group string="Details">
                        <group>
                        <field name="hrx_currency_id" invisible="1"/>
                        <field name="hrx_current_salary"/>
                        <field name="hrx_total_experience"/>
                        <field name="hrx_notice_period"/>
                    </group>
                    <group>
                        <field name="hrx_verification_state"/>
                        <field name="hrx_verification_note"/>
                    </group>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>