<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM -->
    <record id="view_mpr_form" model="ir.ui.view">
        <field name="name">manpower.requisition.form</field>
        <field name="model">manpower.requisition</field>
        <field name="arch" type="xml">
            <form string="Manpower Requisition">
                <header>
                    <button name="action_submit" string="Submit to HR" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="hrx_manpower_requisition.group_mpr_dept_head,hrx_manpower_requisition.group_mpr_hr_exec"/>
                    <button name="action_send_for_approval" string="Send for Approval" type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="hrx_manpower_requisition.group_mpr_hr_exec"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'pending_approval'"
                            groups="hrx_manpower_requisition.group_mpr_management"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"
                            groups="hrx_manpower_requisition.group_mpr_hr_exec"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending_approval'"
                            groups="hrx_manpower_requisition.group_mpr_management"/>
                    <button name="action_open_job" string="Open Job in Recruitment" type="object" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="hrx_manpower_requisition.group_mpr_hr_exec"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'rejected'"
                            groups="hrx_manpower_requisition.group_mpr_dept_head,hrx_manpower_requisition.group_mpr_hr_exec"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,pending_approval,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="department_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                            <field name="position_name" readonly="state != 'draft'"/>
                            <field name="job_id" options="{'no_create': True}"
                                   readonly="state not in ('draft', 'submitted', 'approved')"/>
                            <field name="vacancies" readonly="state != 'draft'"/>
                            <field name="joining_requirement" readonly="state != 'draft'"/>
                        </group>
                        <group string="Reason">
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="replaced_employee_id" options="{'no_create': True}"
                                   invisible="reason != 'replacement'"
                                   required="reason == 'replacement'"
                                   readonly="state != 'draft'"/>
                            <field name="reason_note" readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="request_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="HR Details"
                           groups="hrx_manpower_requisition.group_mpr_hr_exec,hrx_manpower_requisition.group_mpr_management">
                        <group>
                            <label for="experience_min" string="Experience (years)"/>
                            <div class="o_row">
                                <field name="experience_min" readonly="state != 'submitted'"/>
                                <span>to</span>
                                <field name="experience_max" readonly="state != 'submitted'"/>
                            </div>
                            <field name="qualification" readonly="state != 'submitted'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <label for="salary_min" string="Salary Range"/>
                            <div class="o_row">
                                <field name="salary_min" readonly="state != 'submitted'"/>
                                <span>to</span>
                                <field name="salary_max" readonly="state != 'submitted'"/>
                            </div>
                            <field name="location" readonly="state != 'submitted'"/>
                        </group>
                    </group>
                    <group string="Decision" invisible="state not in ('approved', 'rejected', 'done')">
                        <field name="approved_by"/>
                        <field name="approval_date"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_mpr_list" model="ir.ui.view">
        <field name="name">manpower.requisition.list</field>
        <field name="model">manpower.requisition</field>
        <field name="arch" type="xml">
            <list string="Manpower Requisitions">
                <field name="name"/>
                <field name="request_date"/>
                <field name="department_id"/>
                <field name="position_name"/>
                <field name="vacancies" sum="Total"/>
                <field name="reason"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted', 'pending_approval')"
                       decoration-success="state in ('approved', 'done')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_mpr_search" model="ir.ui.view">
        <field name="name">manpower.requisition.search</field>
        <field name="model">manpower.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="position_name"/>
                <field name="department_id"/>
                <field name="requested_by"/>
                <filter name="my_requests" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_submitted" string="Submitted to HR" domain="[('state', '=', 'submitted')]"/>
                <filter name="f_pending" string="Pending Approval" domain="[('state', '=', 'pending_approval')]"/>
                <filter name="f_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="f_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="f_done" string="Job Opened" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_mpr_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">manpower.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requested_by', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise your first manpower requisition</p>
        </field>
    </record>

    <record id="action_mpr_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">manpower.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_department': 1}</field>
    </record>

    <record id="action_mpr_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">manpower.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending_approval')]</field>
    </record>
</odoo>
