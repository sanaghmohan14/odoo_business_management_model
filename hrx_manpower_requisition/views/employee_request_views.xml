<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM -->
    <record id="view_hrx_emp_req_form" model="ir.ui.view">
        <field name="name">hrx.employee.request.form</field>
        <field name="model">hrx.employee.request</field>
        <field name="arch" type="xml">
            <form string="Employee HR Request">
                <header>
                    <button name="action_assign" string="Assign to Me" type="object" class="btn-primary"
                            invisible="state != 'raised'" groups="hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_start" string="Set In Progress" type="object" class="btn-primary"
                            invisible="state not in ('raised', 'assigned')" groups="hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_take_action" string="Record Action Taken" type="object" class="btn-primary"
                            invisible="state != 'in_progress'" groups="hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_complete" string="Mark Completed" type="object" class="btn-primary"
                            invisible="state != 'action_taken'" groups="hrx_manpower_requisition.group_hrx_hr"/>
                    <button name="action_close" string="Close Ticket" type="object" class="btn-secondary"
                            invisible="state != 'completed'"/>
                    <button name="action_cancel" string="Cancel Request" type="object"
                            invisible="state in ('completed', 'closed', 'cancelled')" confirm="Cancel this request?"/>
                    <field name="state" widget="statusbar" statusbar_visible="raised,assigned,in_progress,action_taken,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'raised'"/>
                            <field name="department_id"/>
                            <field name="request_type" readonly="state != 'raised'"/>
                            <field name="priority" widget="priority" readonly="state != 'raised'"/>
                        </group>
                        <group>
                            <field name="assigned_to" readonly="state in ('completed', 'closed', 'cancelled')"/>
                            <field name="resolution_date" invisible="not resolution_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Subject &amp; Details">
                        <field name="subject" readonly="state != 'raised'"/>
                        <field name="description" nolabel="1" colspan="2" readonly="state != 'raised'"/>
                    </group>
                    <group string="Action Taken by HR" invisible="state in ('raised', 'assigned')">
                        <field name="action_taken" nolabel="1" colspan="2" readonly="state in ('completed', 'closed')"/>
                    </group>
                    <group string="Closure Remarks" invisible="state != 'closed'">
                        <field name="closure_notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_hrx_emp_req_list" model="ir.ui.view">
        <field name="name">hrx.employee.request.list</field>
        <field name="model">hrx.employee.request</field>
        <field name="arch" type="xml">
            <list string="Employee HR Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="request_type"/>
                <field name="subject"/>
                <field name="priority" widget="priority"/>
                <field name="assigned_to"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('raised', 'assigned')"
                       decoration-warning="state in ('in_progress', 'action_taken')"
                       decoration-success="state in ('completed', 'closed')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_hrx_emp_req_search" model="ir.ui.view">
        <field name="name">hrx.employee.request.search</field>
        <field name="model">hrx.employee.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <field name="subject"/>
                <filter name="my_requests" string="My Requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="to_do" string="Open Requests" domain="[('state', 'not in', ('closed', 'cancelled'))]"/>
                <group>
                    <filter name="group_type" string="Request Type" context="{'group_by': 'request_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_assigned" string="Assigned HR" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_hrx_emp_req_my" model="ir.actions.act_window">
        <field name="name">My HR Requests</field>
        <field name="res_model">hrx.employee.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_hrx_emp_req_all" model="ir.actions.act_window">
        <field name="name">All Employee Requests</field>
        <field name="res_model">hrx.employee.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_do': 1}</field>
    </record>
</odoo>
