<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_hrx_probation_alert" model="ir.cron">
        <field name="name">HRX: Probation ending alerts</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._hrx_cron_probation_alert()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_hrx_discipline_followup" model="ir.cron">
        <field name="name">HRX: Discipline follow-up reminders</field>
        <field name="model_id" ref="model_hrx_discipline_case"/>
        <field name="state">code</field>
        <field name="code">model._cron_followup_reminder()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>


</odoo>