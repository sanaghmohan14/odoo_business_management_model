<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpr_reject_wizard_form" model="ir.ui.view">
        <field name="name">manpower.requisition.reject.wizard.form</field>
        <field name="model">manpower.requisition.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Requisition">
                <group>
                    <field name="requisition_id" invisible="1"/>
                    <field name="reason" placeholder="Why is this requisition being rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
